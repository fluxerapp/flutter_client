**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec_overrides.yaml
/build/
packages/*/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase (FCM flavor builds)
/android/app/google-services.json
packages/fluxer_fcm/lib/firebase_options.dart

# Git worktrees
.worktrees/
packages/fluxer_fcm/build/
packages/fluxer_fcm/pubspec.lock
vendor/

# Measure credentials (generated by tool/measure/write_native_measure_config.sh)
/android/measure.properties
/ios/Flutter/MeasureSecrets.xcconfig
ios/build/
