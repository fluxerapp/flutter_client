<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:web.fluxer.app</string>
		<string>applinks:web.canary.fluxer.app</string>
		<string>applinks:web.fluxer.com</string>
		<string>applinks:web.canary.fluxer.com</string>
		<string>applinks:fluxer.gg</string>
		<string>webcredentials:fluxer.app</string>
		<string>webcredentials:web.fluxer.app</string>
		<string>webcredentials:fluxer.com</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.fluxer</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.fluxer</string>
		<string>$(AppIdentifierPrefix)com.fluxer.canary</string>
	</array>
</dict>
</plist>
