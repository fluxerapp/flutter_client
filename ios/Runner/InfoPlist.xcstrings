{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Fluxer الكاميرا عندما تلتقط صورة لإرسالها في دردشة أو عندما تشغّل الكاميرا في مكالمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer използва камерата, когато правиш снимка, за да я изпратиш в чат, или когато включиш камерата си в разговор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer používá fotoaparát, když pořizujete fotku k odeslání do chatu nebo když v hovoru zapnete kameru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer bruger kameraet, når du tager et billede for at sende det i en chat eller slår dit kamera til i et opkald."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer verwendet die Kamera, wenn du ein Foto aufnimmst, um es in einem Chat zu senden, oder wenn du in einem Anruf deine Kamera einschaltest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fluxer χρησιμοποιεί την κάμερα όταν τραβάτε μια φωτογραφία για να τη στείλετε σε συνομιλία ή ενεργοποιείτε την κάμερά σας σε μια κλήση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer uses the camera when you take a photo to send in a chat or turn on your camera in a call."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer uses the camera when you take a photo to send in a chat or turn on your camera in a call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa la cámara cuando haces una foto para enviarla en un chat o cuando activas la cámara en una llamada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa la cámara cuando tomas una foto para enviarla en un chat o cuando activas tu cámara en una llamada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer käyttää kameraa, kun otat kuvan lähetettäväksi keskusteluun tai laitat kamerasi päälle puhelussa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer utilise l'appareil photo quand vous prenez une photo à envoyer dans une discussion ou quand vous activez votre caméra pendant un appel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer משתמש במצלמה כשאתה מצלם תמונה כדי לשלוח בצ'אט או מפעיל את המצלמה שלך בשיחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप किसी चैट में भेजने के लिए फ़ोटो लेते हैं या किसी कॉल में अपना कैमरा चालू करते हैं, तब Fluxer कैमरे का इस्तेमाल करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer koristi kameru kada snimite fotografiju koju šaljete u razgovoru ili uključite kameru u pozivu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fluxer akkor használja a kamerát, amikor fényképet készítesz, hogy elküldd egy csevegésben, vagy bekapcsolod a kamerádat egy hívásban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer menggunakan kamera saat kamu mengambil foto untuk dikirim di chat atau menyalakan kamera dalam panggilan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa la fotocamera quando scatti una foto da inviare in una chat o attivi la fotocamera in una chiamata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxerは、チャットで送信する写真を撮るときや、通話でカメラをオンにするときにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer는 채팅에 보낼 사진을 찍거나 통화에서 카메라를 켤 때 카메라를 사용합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer naudoja kamerą, kai fotografuojate, kad nuotrauką išsiųstumėte pokalbyje, arba kai skambučio metu įjungiate kamerą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer bruker kameraet når du tar et bilde for å sende i en chat eller slår på kameraet i en samtale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer gebruikt de camera wanneer je een foto maakt om in een chat te versturen of je camera inschakelt in een gesprek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer używa aparatu, gdy robisz zdjęcie do wysłania na czacie lub włączasz kamerę podczas rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fluxer usa a câmera quando você tira uma foto para enviar em um chat ou ativa sua câmera em uma chamada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer folosește camera când faci o fotografie pentru a o trimite într-un chat sau când îți pornești camera într-un apel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer использует камеру, когда вы делаете фото, чтобы отправить его в чат, или включаете камеру во время звонка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer använder kameran när du tar ett foto för att skicka i en chatt eller slår på kameran i ett samtal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer ใช้กล้องเมื่อคุณถ่ายรูปเพื่อส่งในแชท หรือเปิดกล้องระหว่างการโทร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer, sohbette göndermek için fotoğraf çektiğinizde veya bir aramada kameranızı açtığınızda kamerayı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer використовує камеру, коли ви робите фото, щоб надіслати його в чат, або вмикаєте камеру під час дзвінка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer sử dụng camera khi bạn chụp ảnh để gửi trong cuộc trò chuyện hoặc bật camera trong cuộc gọi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你拍摄照片以在聊天中发送，或在通话中开启摄像头时，Fluxer 会使用相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您拍攝要在聊天中傳送的照片，或在通話中開啟鏡頭時，Fluxer 會使用相機。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Fluxer شبكتك المحلية للمكالمات بين الأجهزة على الشبكة نفسها وللاتصال بمثيل Fluxer يعمل على شبكتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer използва локалната ти мрежа за разговори между устройства в една и съща мрежа и за свързване с инстанция на Fluxer, работеща в мрежата ти."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer používá vaši místní síť pro hovory mezi zařízeními ve stejné síti a pro připojení k instanci Fluxer běžící ve vaší síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer bruger dit lokale netværk til opkald mellem enheder på samme netværk og til at oprette forbindelse til en Fluxer-instans, der kører på dit netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer verwendet dein lokales Netzwerk für Anrufe zwischen Geräten im selben Netzwerk und um sich mit einer Fluxer-Instanz in deinem Netzwerk zu verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fluxer χρησιμοποιεί το τοπικό σας δίκτυο για κλήσεις μεταξύ συσκευών στο ίδιο δίκτυο και για σύνδεση σε μια παρουσία Fluxer που εκτελείται στο δίκτυό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer uses your local network for calls between devices on the same network and to connect to a Fluxer instance running on your network."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer uses your local network for calls between devices on the same network and to connect to a Fluxer instance running on your network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa tu red local para las llamadas entre dispositivos de la misma red y para conectarse a una instancia de Fluxer que funcione en tu red."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa tu red local para llamadas entre dispositivos de la misma red y para conectarse a una instancia de Fluxer que se ejecuta en tu red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer käyttää lähiverkkoasi saman verkon laitteiden välisiin puheluihin ja yhteyden muodostamiseen verkossasi toimivaan Fluxer-instanssiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer utilise votre réseau local pour les appels entre appareils connectés au même réseau et pour se connecter à une instance Fluxer qui tourne sur votre réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer משתמש ברשת המקומית שלך לשיחות בין מכשירים באותה רשת ולהתחברות למופע Fluxer שפועל ברשת שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer आपके लोकल नेटवर्क का इस्तेमाल एक ही नेटवर्क पर मौजूद डिवाइस के बीच कॉल के लिए और आपके नेटवर्क पर चल रहे Fluxer इंस्टेंस से कनेक्ट करने के लिए करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer koristi vašu lokalnu mrežu za pozive između uređaja na istoj mreži i za povezivanje s Fluxer instancom koja radi na vašoj mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fluxer a helyi hálózatodat az ugyanazon a hálózaton lévő eszközök közötti hívásokhoz, valamint a hálózatodon futó Fluxer-példányhoz való csatlakozáshoz használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer menggunakan jaringan lokalmu untuk panggilan antarperangkat di jaringan yang sama dan untuk terhubung ke instance Fluxer yang berjalan di jaringanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa la tua rete locale per le chiamate tra dispositivi sulla stessa rete e per connettersi a un'istanza Fluxer in esecuzione sulla tua rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxerは、同じネットワーク上のデバイス間での通話と、ネットワーク上で動作しているFluxerインスタンスへの接続にローカルネットワークを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer는 같은 네트워크에 있는 기기 간 통화와 회원님의 네트워크에서 실행 중인 Fluxer 인스턴스에 연결할 때 로컬 네트워크를 사용합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer naudoja jūsų vietinį tinklą skambučiams tarp to paties tinklo įrenginių ir prisijungimui prie jūsų tinkle veikiančios Fluxer instancijos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer bruker det lokale nettverket ditt til samtaler mellom enheter på samme nettverk og til å koble til en Fluxer-instans som kjører på nettverket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer gebruikt je lokale netwerk voor gesprekken tussen apparaten op hetzelfde netwerk en om verbinding te maken met een Fluxer-instantie die op je netwerk draait."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer używa Twojej sieci lokalnej do połączeń między urządzeniami w tej samej sieci oraz do łączenia się z instancją Fluxer działającą w Twojej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fluxer usa sua rede local para chamadas entre dispositivos na mesma rede e para se conectar a uma instância do Fluxer executada na sua rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer folosește rețeaua locală pentru apelurile dintre dispozitivele din aceeași rețea și pentru a se conecta la o instanță Fluxer care rulează în rețeaua ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer использует вашу локальную сеть для звонков между устройствами в одной сети и для подключения к экземпляру Fluxer, работающему в вашей сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer använder ditt lokala nätverk för samtal mellan enheter i samma nätverk och för att ansluta till en Fluxer-instans som körs i ditt nätverk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer ใช้เครือข่ายภายในของคุณสำหรับการโทรระหว่างอุปกรณ์ที่อยู่ในเครือข่ายเดียวกัน และเพื่อเชื่อมต่อกับอินสแตนซ์ Fluxer ที่ทำงานอยู่ในเครือข่ายของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer, aynı ağdaki cihazlar arasındaki aramalar ve ağınızda çalışan bir Fluxer kurulumuna bağlanmak için yerel ağınızı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer використовує вашу локальну мережу для дзвінків між пристроями в одній мережі та для підключення до екземпляра Fluxer, що працює у вашій мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer sử dụng mạng cục bộ của bạn cho các cuộc gọi giữa các thiết bị trong cùng mạng và để kết nối với máy chủ Fluxer chạy trong mạng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer 使用你的本地网络，用于同一网络中设备之间的通话，以及连接在你网络中运行的 Fluxer 实例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer 會使用您的區域網路，在同一網路上的裝置之間進行通話，以及連線到在您網路上執行的 Fluxer 伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Fluxer الميكروفون عندما تسجّل رسالة صوتية، أو تتحدث في مكالمة صوتية أو مكالمة فيديو، أو تختبر الميكروفون في الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer използва микрофона, когато записваш гласово съобщение, говориш в гласов или видеоразговор или тестваш микрофона си в настройките."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer používá mikrofon, když nahráváte hlasovou zprávu, mluvíte v hlasovém nebo video hovoru nebo testujete mikrofon v nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer bruger mikrofonen, når du optager en talebesked, taler i et tale- eller videoopkald eller tester din mikrofon i indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer verwendet das Mikrofon, wenn du eine Sprachnachricht aufnimmst, in einem Sprach- oder Videoanruf sprichst oder dein Mikrofon in den Einstellungen testest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fluxer χρησιμοποιεί το μικρόφωνο όταν ηχογραφείτε φωνητικό μήνυμα, μιλάτε σε φωνητική κλήση ή βιντεοκλήση ή δοκιμάζετε το μικρόφωνό σας στις ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer uses the microphone when you record a voice message, talk in a voice or video call, or test your microphone in settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer uses the microphone when you record a voice message, talk in a voice or video call, or test your microphone in settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa el micrófono cuando grabas un mensaje de voz, hablas en una llamada de voz o vídeo, o pruebas el micrófono en los ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxer usa el micrófono cuando grabas un mensaje de voz, hablas en una llamada de voz o video, o pruebas tu micrófono en la configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
