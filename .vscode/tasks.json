      "dependsOrder": "sequence",
      "dependsOn": [
        "build: configure oss",
        "flutter: pub get",
        "markdown: native parser"
      ],
      "problemMatcher": []
    },
    {
      "label": "build: Android FCM + Play billing",
      "detail": "Switch to the android-fcm profile.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build: configure android-fcm",
        "flutter: pub get",
        "markdown: native parser"
      ],
      "problemMatcher": []
    },
    {
      "label": "build: restore dev",
      "detail": "Switch back to the dev profile.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build: configure dev",
        "flutter: pub get",
        "markdown: native parser"
      ],
      "problemMatcher": []
    },
    {
      "label": "git: install hooks",
      "type": "shell",
      "command": "bash tool/install_hooks.sh",
      "problemMatcher": []
    },
    {
      "label": "build: configure oss",
      "type": "shell",
      "command": "dart tool/configure_build.dart --profile=oss",
      "problemMatcher": []
    },
    {
      "label": "build: configure android-fcm",
      "type": "shell",
      "command": "dart tool/configure_build.dart --profile=android-fcm",
      "problemMatcher": []
    },
    {
      "label": "build: configure dev",
      "type": "shell",
      "command": "dart tool/configure_build.dart --profile=dev",
      "problemMatcher": []
    },
    {
      "label": "flutter: pub get",
      "type": "shell",
      "command": "flutter pub get",
      "problemMatcher": []
    },
    {
      "label": "markdown: native parser",
      "detail": "Enable native assets, install Rust targets for Android and iOS (device and simulator), and init the fluxer parser crate if it is missing.",
      "type": "shell",
      "command": "dart tool/setup_native_markdown.dart",
      "problemMatcher": []
    }
  ]
