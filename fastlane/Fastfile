require "yaml"

default_platform(:ios)

def fetchRequiredEnvironmentValue(key)
  return ENV.fetch(key)
end

def fetchOptionalEnvironmentValue(key, defaultValue)
  return ENV[key] || defaultValue
end

def project_root_path
  File.expand_path("..", __dir__)
end

def flutter_marketing_version
  pubspec_path = File.join(project_root_path, "pubspec.yaml")
  version = YAML.safe_load_file(pubspec_path).fetch("version")
  version.to_s.split("+", 2).first
end

platform :ios do
  desc "Build beta archive and upload to TestFlight"
  lane :testflight_beta do
    profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/profile.mobileprovision")
    extension_profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/broadcast_extension.mobileprovision")
    notification_service_profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/notification_service.mobileprovision")
    runner_profile_uuid = fetchRequiredEnvironmentValue("PROFILE_UUID")
    extension_profile_uuid = fetchOptionalEnvironmentValue("BROADCAST_EXTENSION_PROFILE_UUID", runner_profile_uuid)
    notification_service_profile_uuid = fetchOptionalEnvironmentValue("NOTIFICATION_SERVICE_PROFILE_UUID", extension_profile_uuid)
    unless File.exist?(notification_service_profile_path)
      notification_service_profile_path = extension_profile_path
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY")
    )

    app_identifier = "com.fluxer"
    flutter_build_name = flutter_marketing_version
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: flutter_build_name,
      initial_build_number: 1
    )
    flutter_build_number = latest_build_number + 1
    UI.message("Building #{app_identifier} #{flutter_build_name} (#{flutter_build_number})")

    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: profile_path,
      target_filter: "^Runner$",
      build_configuration: "Release-beta",
      code_signing_identity: "Apple Distribution"
    )
    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: extension_profile_path,
      target_filter: "^BroadcastExtension$",
      build_configuration: "Release-beta",
      code_signing_identity: "Apple Distribution"
    )
    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: notification_service_profile_path,
      target_filter: "^NotificationService$",
      build_configuration: "Release-beta",
      code_signing_identity: "Apple Distribution"
    )
    cocoapods(
      podfile: "ios/Podfile",
      clean_install: true
    )

    sh(
      "flutter",
      "build",
      "ios",
      "--release",
      "--flavor",
      "beta",
      "--no-codesign",
      "--build-name",
      flutter_build_name,
      "--build-number",
      flutter_build_number.to_s,
      "--dart-define-from-file=#{File.join(project_root_path, "tool/dart_defines/beta.json")}",
      "--dart-define=PUSH_PROVIDER=apns",
      "--dart-define=BUILD_TIMESTAMP=#{Time.now.utc.iso8601}",
      "--dart-define=BETA_NUMBER=#{ENV["BETA_NUMBER"]}"
    )
    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "beta",
      configuration: "Release-beta",
      clean: true,
      output_directory: "build/ios/ipa",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.fluxer" => runner_profile_uuid,
          "com.fluxer.BroadcastExtension" => extension_profile_uuid,
          "com.fluxer.NotificationService" => notification_service_profile_uuid
        }
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID")}",
        "FLUTTER_BUILD_NAME=#{flutter_build_name}",
        "FLUTTER_BUILD_NUMBER=#{flutter_build_number}",
        "CODE_SIGN_STYLE=Manual",
      ].join(" ")
    )
    maximum_attempts = 3
    attempt_index = 1
    begin
      upload_to_testflight(
        api_key: api_key,
        ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
        skip_waiting_for_build_processing: true
      )
    rescue => err
      if err.message.include?("The bundle version must be higher") || err.message.include?("-19232")
        raise err
      end
      if attempt_index >= maximum_attempts
        raise err
      end
      retry_delay_seconds = attempt_index * 30
      UI.important("TestFlight upload failed on attempt #{attempt_index}/#{maximum_attempts}: #{err.message}")
      UI.important("Retrying upload in #{retry_delay_seconds} seconds...")
      sleep(retry_delay_seconds)
      attempt_index += 1
      retry
    end
  end

  desc "Build canary archive and upload to TestFlight (com.fluxer.canary)"
  lane :testflight_canary do
    profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/profile.mobileprovision")
    extension_profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/broadcast_extension.mobileprovision")
    notification_service_profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/notification_service.mobileprovision")
    runner_profile_uuid = fetchRequiredEnvironmentValue("PROFILE_UUID")
    extension_profile_uuid = fetchOptionalEnvironmentValue("BROADCAST_EXTENSION_PROFILE_UUID", runner_profile_uuid)
    notification_service_profile_uuid = fetchOptionalEnvironmentValue("NOTIFICATION_SERVICE_PROFILE_UUID", extension_profile_uuid)
    unless File.exist?(notification_service_profile_path)
      notification_service_profile_path = extension_profile_path
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY")
    )

    app_identifier = "com.fluxer.canary"
    flutter_build_name = flutter_marketing_version
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: flutter_build_name,
      initial_build_number: 1
    )
    flutter_build_number = latest_build_number + 1
    UI.message("Building #{app_identifier} #{flutter_build_name} (#{flutter_build_number})")

    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: profile_path,
      target_filter: "^Runner$",
      build_configuration: "Release-canary",
      code_signing_identity: "Apple Distribution"
    )
    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: extension_profile_path,
      target_filter: "^BroadcastExtension$",
      build_configuration: "Release-canary",
      code_signing_identity: "Apple Distribution"
    )
    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: notification_service_profile_path,
      target_filter: "^NotificationService$",
      build_configuration: "Release-canary",
      code_signing_identity: "Apple Distribution"
    )
    cocoapods(
      podfile: "ios/Podfile",
      clean_install: true
    )

    sh(
      "flutter",
      "build",
      "ios",
      "--release",
      "--flavor",
      "canary",
      "--no-codesign",
      "--build-name",
      flutter_build_name,
      "--build-number",
      flutter_build_number.to_s,
      "--dart-define-from-file=#{File.join(project_root_path, "tool/dart_defines/canary.json")}",
      "--dart-define=PUSH_PROVIDER=apns",
      "--dart-define=BUILD_TIMESTAMP=#{Time.now.utc.iso8601}"
    )
    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "canary",
      configuration: "Release-canary",
      clean: true,
      output_directory: "build/ios/ipa",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.fluxer.canary" => runner_profile_uuid,
          "com.fluxer.canary.BroadcastExtension" => extension_profile_uuid,
          "com.fluxer.canary.NotificationService" => notification_service_profile_uuid
        }
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID")}",
        "FLUTTER_BUILD_NAME=#{flutter_build_name}",
        "FLUTTER_BUILD_NUMBER=#{flutter_build_number}",
        "CODE_SIGN_STYLE=Manual",
      ].join(" ")
    )
    changelog = "Build from GitHub Actions run: #{ENV['GITHUB_SERVER_URL']}/#{ENV['GITHUB_REPOSITORY']}/actions/runs/#{ENV['GITHUB_RUN_ID']}"

    upload_to_testflight(
      api_key: api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
    UI.success("Build #{flutter_build_number} uploaded to TestFlight")

    wait_for_processed_build(
      api_key: api_key,
      app_identifier: app_identifier,
      app_version: flutter_build_name,
      build_number: flutter_build_number,
      groups: ["Fluxer Team", "Development collaborations"],
      changelog: changelog
    )
  end

  def wait_for_processed_build(api_key:, app_identifier:, app_version:, build_number:, groups:, changelog:)
    maximum_wait_attempts = 40
    attempt_index = 0

    jwt = Spaceship::ConnectAPI::Token.from(hash: api_key)
    Spaceship::ConnectAPI.token = jwt

    begin
      loop do
        attempt_index += 1

        if attempt_index > maximum_wait_attempts
          UI.important("Build #{build_number} processing timeout. Build was uploaded but distribution requires manual action.")
          return
        end

        begin
          app = Spaceship::ConnectAPI::App.find(app_identifier)
          builds = Spaceship::ConnectAPI::Build.all(
            app_id: app.id,
            version: app_version,
            build_number: build_number.to_s,
            platform: Spaceship::ConnectAPI::Platform::IOS,
            limit: 1
          )
          build = builds.first

          if build.nil?
            UI.message("Build #{app_version} (#{build_number}) not found yet, waiting... (attempt #{attempt_index}/#{maximum_wait_attempts})")
            sleep(30)
            next
          end

          case build.processing_state
          when "VALID"
            UI.success("Build #{app_version} (#{build_number}) is ready for distribution")
            distribute_to_groups(build: build, app: app, groups: groups, changelog: changelog)
            return
          when "INVALID"
            UI.error("Build #{app_version} (#{build_number}) processing failed (INVALID)")
            raise "Build processing failed"
          else
            UI.message("Build #{app_version} (#{build_number}) is #{build.processing_state}, waiting... (attempt #{attempt_index}/#{maximum_wait_attempts})")
            sleep(30)
          end
        rescue => poll_err
          if poll_err.message.include?("timeout") || poll_err.message.include?("connection")
            UI.important("Polling error: #{poll_err.message}, will retry...")
            sleep(30)
          else
            raise poll_err
          end
        end
      end
    rescue => err
      UI.important("Distribution step failed: #{err.message}")
      UI.important("Build #{build_number} was uploaded successfully to TestFlight")
      UI.important("Manual distribution to groups may be required: #{groups.join(', ')}")
    end
  end

  def distribute_to_groups(build:, app:, groups:, changelog:)
    beta_groups = groups.map { |name| app.get_beta_groups(filter: { name: name }).first }.compact

    if beta_groups.empty?
      UI.important("No beta groups found for distribution")
      return
    end

    update_build_changelog(build: build, changelog: changelog)

    if build.ready_for_beta_submission?
      build.post_beta_app_review_submission
    else
      UI.message("Build #{build.app_version} (#{build.version}) does not require beta review submission")
    end

    build.add_beta_groups(beta_groups: beta_groups)
    if build.build_beta_detail
      Spaceship::ConnectAPI.patch_build_beta_details(
        build_beta_details_id: build.build_beta_detail.id,
        attributes: { autoNotifyEnabled: true }
      )
    else
      UI.important("Unable to enable tester auto notifications because build beta details were not returned")
    end
    UI.success("Distributed to groups: #{beta_groups.map(&:name).join(', ')}")
  end

  def update_build_changelog(build:, changelog:)
    return if changelog.to_s.empty?

    attributes = { whatsNew: changelog }
    localization = build.get_beta_build_localizations.find { |item| item.locale == "en-US" }

    if localization
      Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: localization.id, attributes: attributes)
    else
      attributes[:locale] = "en-US"
      Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: attributes)
    end
  end

  desc "Build stable IPA and upload to App Store Connect as a processing build only (no App Review submission, no automatic release)"
  lane :stable_release do
    profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/profile.mobileprovision")
    extension_profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/broadcast_extension.mobileprovision")
    notification_service_profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/notification_service.mobileprovision")
    runner_profile_uuid = fetchRequiredEnvironmentValue("PROFILE_UUID")
    extension_profile_uuid = fetchOptionalEnvironmentValue("BROADCAST_EXTENSION_PROFILE_UUID", runner_profile_uuid)
    notification_service_profile_uuid = fetchOptionalEnvironmentValue("NOTIFICATION_SERVICE_PROFILE_UUID", extension_profile_uuid)
    unless File.exist?(notification_service_profile_path)
      notification_service_profile_path = extension_profile_path
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY")
    )

    app_identifier = "com.fluxer"
    flutter_build_name = flutter_marketing_version
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: flutter_build_name,
      initial_build_number: 1
    )
    flutter_build_number = latest_build_number + 1
    UI.message("Building #{app_identifier} #{flutter_build_name} (#{flutter_build_number})")

    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: profile_path,
      target_filter: "^Runner$",
      build_configuration: "Release-stable",
      code_signing_identity: "Apple Distribution"
    )
    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: extension_profile_path,
      target_filter: "^BroadcastExtension$",
      build_configuration: "Release-stable",
      code_signing_identity: "Apple Distribution"
    )
    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: notification_service_profile_path,
      target_filter: "^NotificationService$",
      build_configuration: "Release-stable",
      code_signing_identity: "Apple Distribution"
    )
    cocoapods(
      podfile: "ios/Podfile",
      clean_install: true
    )

    sh(
      "flutter",
      "build",
      "ios",
      "--release",
      "--flavor",
      "stable",
      "--no-codesign",
      "--build-name",
      flutter_build_name,
      "--build-number",
      flutter_build_number.to_s,
      "--dart-define-from-file=#{File.join(project_root_path, "tool/dart_defines/stable.json")}",
      "--dart-define=PUSH_PROVIDER=apns",
      "--dart-define=BUILD_TIMESTAMP=#{Time.now.utc.iso8601}"
    )
    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "stable",
      configuration: "Release-stable",
      clean: true,
      output_directory: "build/ios/ipa",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.fluxer" => runner_profile_uuid,
          "com.fluxer.BroadcastExtension" => extension_profile_uuid,
          "com.fluxer.NotificationService" => notification_service_profile_uuid
        }
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID")}",
        "FLUTTER_BUILD_NAME=#{flutter_build_name}",
        "FLUTTER_BUILD_NUMBER=#{flutter_build_number}",
        "CODE_SIGN_STYLE=Manual",
      ].join(" ")
    )
    maximum_attempts = 3
    attempt_index = 1
    begin
      upload_to_app_store(
        api_key: api_key,
        ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
        app_identifier: app_identifier,
        skip_metadata: true,
        skip_screenshots: true,
        skip_app_version_update: true,
        force: true,
        submit_for_review: false,
        automatic_release: false,
        run_precheck_before_submit: false,
        precheck_include_in_app_purchases: false
      )
    rescue => err
      if err.message.include?("The bundle version must be higher") || err.message.include?("-19232")
        raise err
      end
      if attempt_index >= maximum_attempts
        raise err
      end
      retry_delay_seconds = attempt_index * 30
      UI.important("App Store upload failed on attempt #{attempt_index}/#{maximum_attempts}: #{err.message}")
      UI.important("Retrying upload in #{retry_delay_seconds} seconds...")
      sleep(retry_delay_seconds)
      attempt_index += 1
      retry
    end
  end
end
